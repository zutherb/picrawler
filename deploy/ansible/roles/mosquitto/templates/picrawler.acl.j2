# {{ ansible_managed }}
# Rights per role come from vars/main.yml, generated from services/common/topics.py.
{% set p = 'crawler/' ~ mosquitto_robot_id %}
{% for user in mosquitto_users %}

user {{ user.name }}
{% set entries = mosquitto_acl[user.role] %}
{% if user.role == 'sensor' %}
{% set entries = entries + (mosquitto_acl_sensor[user.sensor] | default([])) %}
{% endif %}
{% for entry in entries %}
topic {{ entry.access }} {{ p }}/{{ entry.topic | replace('{sensor}', user.sensor | default('')) }}
{% endfor %}
{% endfor %}
