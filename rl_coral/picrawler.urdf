<?xml version="1.0"?>
<!-- SunFounder PiCrawler for rl_coral/sim_env.py. Generated geometry, units m / kg.
     Link lengths match picrawler/kinematics.py (coxa C=33, femur A=48, tibia B=78 mm),
     hips on a 77 mm square (MoveList.LENGTH_SIDE), legs at the 45 degree corners.
     Body frame: x right, y forward, z up. Joint zero: leg on its diagonal, femur
     horizontal, tibia in line with the femur. See rl_coral/common.py joint_angles(). -->
<robot name="picrawler">
  <material name="body"><color rgba="0.15 0.18 0.22 1"/></material>
  <material name="leg"><color rgba="0.12 0.62 0.62 1"/></material>
  <material name="foot"><color rgba="0.9 0.9 0.9 1"/></material>
  <link name="torso">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="6.107e-04" ixy="0" ixz="0" iyy="6.107e-04" iyz="0" izz="1.109e-03"/>
    </inertial>
    <visual>
      <geometry><box size="0.11 0.11 0.035"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <geometry><box size="0.11 0.11 0.035"/></geometry>
    </collision>
  </link>
